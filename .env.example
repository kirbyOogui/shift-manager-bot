# このファイルをコピーして .env にリネームし、各値を設定してください
# .env はGitにコミットしないでください

# LINE Messaging API
LINE_CHANNEL_SECRET=ここにLINEチャネルシークレットを入力
LINE_CHANNEL_ACCESS_TOKEN=ここにLINEチャネルアクセストークンを入力

# OpenAI
OPENAI_API_KEY=ここにOpenAI APIキーを入力

# Google Sheets（サービスアカウント）
# サービスアカウントのJSONファイルの中身をそのまま1行で貼り付ける
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
GOOGLE_SPREADSHEET_ID=ここにスプレッドシートIDを入力

# Google OAuth（各ユーザーのカレンダー連携用）
# Google Cloud Console > 認証情報 > OAuth 2.0 クライアントID（ウェブアプリケーション）
GOOGLE_CLIENT_ID=ここにOAuthクライアントIDを入力
GOOGLE_CLIENT_SECRET=ここにOAuthクライアントシークレットを入力

# アプリのベースURL
# ローカル開発時：ngrokが発行したhttpsのURL（例: https://xxxx.ngrok-free.app）
# 本番（fly.io）：https://<アプリ名>.fly.dev
APP_BASE_URL=https://xxxx.ngrok-free.app
